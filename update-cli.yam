schemaVersion: 2

project:
  name: ai-tools-omniroute
  type: docker-compose
  description: Build and operate OmniRoute/Open WebUI through the authoritative omniroute-cli Go application.

defaults:
  timeout: 20m
  failFast: true

requirements:
  commands:
    - go
    - docker

workflows:
  setup:
    tasks: [update-stack]
  update:
    tasks: [update-stack]
  rebuild:
    tasks: [recreate-stack]
  build-cli:
    tasks: [build-cli]
  check-cli:
    tasks: [check-cli]
  pull:
    tasks: [pull-stack]
  start:
    tasks: [start-stack]
  stop:
    tasks: [stop-stack]
  status:
    tasks: [status-stack]
  doctor:
    tasks: [doctor-stack]

tasks:
  check-cli:
    steps:
      - name: Validate semantic VERSION with Go SemVer parser
        shell: |
          go run ./cmd/semver-check "$(cat VERSION)" >/dev/null
      - name: Check Go formatting
        shell: |
          FILES="$(gofmt -l ./cmd ./src)"
          test -z "${FILES}" || { echo "Files require gofmt:"; echo "${FILES}"; exit 1; }
      - name: Run go vet
        command:
          exec: go
          args: [vet, ./...]
      - name: Run Go tests
        command:
          exec: go
          args: [test, ./...]

  build-cli:
    requires: [check-cli]
    steps:
      - name: Create binary directory
        mkdir: bin
      - name: Build omniroute-cli
        shell: |
          VERSION="$(cat VERSION)"
          go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o bin/omniroute-cli ./cmd/omniroute-cli
          ./bin/omniroute-cli --version

  init-stack:
    requires: [build-cli]
    steps:
      - name: Initialize secure environment
        shell: ./bin/omniroute-cli init

  pull-stack:
    requires: [build-cli]
    steps:
      - name: Pull configured images through omniroute-cli
        shell: ./bin/omniroute-cli --timeout 15m pull

  update-stack:
    requires: [build-cli]
    steps:
      - name: Transactional image update with health verification and rollback
        shell: ./bin/omniroute-cli --timeout 15m update --wait 2m

  recreate-stack:
    requires: [build-cli]
    steps:
      - name: Recreate stack without pulling
        shell: ./bin/omniroute-cli --timeout 5m recreate

  start-stack:
    requires: [build-cli]
    steps:
      - name: Start existing containers
        shell: ./bin/omniroute-cli start

  stop-stack:
    requires: [build-cli]
    steps:
      - name: Stop containers
        shell: ./bin/omniroute-cli stop

  status-stack:
    requires: [build-cli]
    steps:
      - name: Show rich application status
        shell: ./bin/omniroute-cli status

  doctor-stack:
    requires: [build-cli]
    steps:
      - name: Run deep diagnostics
        shell: ./bin/omniroute-cli doctor --deep
