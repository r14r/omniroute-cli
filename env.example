# ai-tools-omniroute
# Copy to .env before first start. update-cli setup does this automatically
# when .env does not yet exist.
#
# IMPORTANT: Replace all sample secrets before exposing the services publicly.

# -----------------------------------------------------------------------------
# Docker images
# -----------------------------------------------------------------------------
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
OPENWEBUI_IMAGE=openwebui/open-webui:latest

# -----------------------------------------------------------------------------
# Public host ports
# Defaults intentionally use the 20000+ range.
# Container ports remain OmniRoute=20128 and Open WebUI=8080.
# -----------------------------------------------------------------------------
OMNIROUTE_PUBLIC_PORT=20128
OPENWEBUI_PUBLIC_PORT=20000

# -----------------------------------------------------------------------------
# OmniRoute required secrets
# Recommended generators:
#   JWT:       openssl rand -base64 48
#   API key:   openssl rand -hex 32
#   Password:  openssl rand -base64 24
#   WS bridge: openssl rand -base64 32
# -----------------------------------------------------------------------------
OMNIROUTE_JWT_SECRET=R8jn3bT4vL2qZ7mN5xK1sP9cF6hW0dA3eY8uJ4iQ7rV2nM5k
OMNIROUTE_API_KEY_SECRET=9d4b0f67a8c133e23f3197e75f49d0a19a4d6c78b8b3c14b535c9e82d89f641a
OMNIROUTE_INITIAL_PASSWORD=Initial-Admin-9uP7xK4m-2026
OMNIROUTE_WS_BRIDGE_SECRET=J7mP2vR9xN4qT8kL5wC1sF6hD3yB0aE7uZ2nM9pQ4rV8

# -----------------------------------------------------------------------------
# OmniRoute recommended security/runtime settings
# Storage encryption is recommended for production deployments.
# -----------------------------------------------------------------------------
OMNIROUTE_STORAGE_ENCRYPTION_KEY=bd3b5ec42f39c9aa8b0acbfcf129fdc3608a1ea5a0dd8f0d7191151aa354bcad
OMNIROUTE_STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_NODE_ENV=production
OMNIROUTE_REQUIRE_API_KEY=false
OMNIROUTE_AUTH_COOKIE_SECURE=false
OMNIROUTE_APP_LOG_TO_FILE=true
OMNIROUTE_MEMORY_MB=512

# API key Open WebUI sends to OmniRoute's OpenAI-compatible /v1 endpoint.
# With OMNIROUTE_REQUIRE_API_KEY=false the default placeholder is sufficient.
# If API-key enforcement is enabled, create a real OmniRoute API key and put it here.
OMNIROUTE_OPENAI_API_KEY=omniroute-local

# -----------------------------------------------------------------------------
# Open WebUI
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
OPENWEBUI_SECRET_KEY=8adf75db2336305e759fa516c1e5e64a706848bf85e3a127f95a837aec73c226
