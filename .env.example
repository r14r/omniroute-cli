# ai-tools-omniroute
# Run `omniroute-cli init` (or `just init`) to create .env securely.
# Secret placeholders below are replaced with cryptographically random values.

# Docker images
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
OPENWEBUI_IMAGE=openwebui/open-webui:latest

# Bind services to localhost by default. Set 0.0.0.0 only when LAN/public access is intentional.
PUBLIC_BIND_ADDRESS=127.0.0.1
OMNIROUTE_PUBLIC_PORT=20128
OPENWEBUI_PUBLIC_PORT=20000

# OmniRoute required secrets - generated by omniroute-cli init
OMNIROUTE_JWT_SECRET=__GENERATE__
OMNIROUTE_API_KEY_SECRET=__GENERATE__

# Initial OmniRoute dashboard password.
# Upstream OmniRoute default: 123456 (do not use this public default).
# `omniroute-cli init` replaces this known default with a unique random password in .env.
OMNIROUTE_INITIAL_PASSWORD=123456

OMNIROUTE_WS_BRIDGE_SECRET=__GENERATE__

# OmniRoute security/runtime settings
OMNIROUTE_STORAGE_ENCRYPTION_KEY=__GENERATE__
OMNIROUTE_STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_NODE_ENV=production
OMNIROUTE_REQUIRE_API_KEY=false
OMNIROUTE_AUTH_COOKIE_SECURE=false
OMNIROUTE_APP_LOG_TO_FILE=true
OMNIROUTE_MEMORY_MB=512

# API key Open WebUI sends to OmniRoute's OpenAI-compatible /v1 endpoint.
OMNIROUTE_OPENAI_API_KEY=omniroute-local

# Open WebUI - generated by omniroute-cli init
OPENWEBUI_SECRET_KEY=__GENERATE__
