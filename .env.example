# ai-tools-omniroute
# `omniroute-cli init` creates .env with unique generated secrets and mode 0600.

# Multi-instance prefix. --project-name/--prefix overrides this for Docker Compose.
OMNIROUTE_PREFIX=ai-tools-omniroute

# Docker images
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
OPENWEBUI_IMAGE=openwebui/open-webui:latest

# Bind localhost by default. Use 0.0.0.0 only deliberately.
PUBLIC_BIND_ADDRESS=127.0.0.1
OMNIROUTE_PUBLIC_PORT=20128
OPENWEBUI_PUBLIC_PORT=20000

# Optional explicit URLs used by CLI HTTP probes/API commands.
OMNIROUTE_URL=
OPENWEBUI_URL=

# OmniRoute required secrets generated by omniroute-cli init
OMNIROUTE_JWT_SECRET=__GENERATE__
OMNIROUTE_API_KEY_SECRET=__GENERATE__

# OmniRoute upstream initial dashboard password; init replaces this public default.
OMNIROUTE_INITIAL_PASSWORD=123456
OMNIROUTE_WS_BRIDGE_SECRET=__GENERATE__
OMNIROUTE_STORAGE_ENCRYPTION_KEY=__GENERATE__

OMNIROUTE_STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_NODE_ENV=production
OMNIROUTE_REQUIRE_API_KEY=false
OMNIROUTE_AUTH_COOKIE_SECURE=false
OMNIROUTE_APP_LOG_TO_FILE=true
OMNIROUTE_MEMORY_MB=512

# Inference key used by Open WebUI and CLI /v1 commands when API-key enforcement is enabled.
OMNIROUTE_OPENAI_API_KEY=omniroute-local

# Optional OmniRoute management credential (prefer oma_live_... with least privilege).
# Required for deep management endpoints when OmniRoute management auth is enabled.
OMNIROUTE_MANAGEMENT_TOKEN=

# Open WebUI secret generated by omniroute-cli init
OPENWEBUI_SECRET_KEY=__GENERATE__
